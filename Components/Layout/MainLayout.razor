@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable
<nav class="afg-navbar">
    <a href="/" class="brand">
        <img src="img/AFG_logo.svg" alt="AllFlightGo" />
        <div class="brand-text">
            <span class="brand-name">AllFlightGo</span>
            <span class="brand-tagline">Go Anywhere</span>
        </div>
    </a>

    <button class="afg-nav-toggle" @onclick="ToggleMenu" aria-label="Toggle menu">
        <span></span><span></span><span></span>
    </button>

    <div class="afg-nav-links @(MenuOpen ? "open" : "")">
        <a href="/" class="@ActiveIf("/")">Home</a>
        <a href="/search" class="@ActiveIf("/search")">Search</a>
        <AuthorizeView>
            <Authorized>
                <a href="/mybookings" class="@ActiveIf("/mybookings")">My Bookings</a>
                <a href="/profile" class="@ActiveIf("/profile")">Profile</a>
                <a href="/logout" class="afg-nav-logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="afg-nav-logout">Sign in with Google</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<main>
    @Body
</main>

<footer class="afg-footer">
    AllFlightGo © @DateTime.Now.Year
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool MenuOpen;
    private void ToggleMenu() => MenuOpen = !MenuOpen;

    private string ActiveIf(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return current.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        MenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}