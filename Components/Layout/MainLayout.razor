@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

@* First focusable thing on the page: lets keyboard users jump straight to the
   content and skip re-tabbing through the whole nav on every page. *@
<a class="afg-skip-link" href="#main-content">Skip to main content</a>

<nav class="afg-navbar">
    <a href="/" class="brand">
        <img src="img/AFG_logo.svg" alt="AllFlightGo home" />
        <div class="brand-text">
            <span class="brand-name">AllFlightGo</span>
            <span class="brand-tagline">Go Anywhere</span>
        </div>
    </a>

    <button class="afg-nav-toggle" @onclick="ToggleMenu"
            aria-label="Toggle navigation menu" aria-expanded="@(MenuOpen ? "true" : "false")" aria-controls="afg-nav-links">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>

    <div id="afg-nav-links" class="afg-nav-links @(MenuOpen ? "open" : "")">
        <a href="/" class="@ActiveIf("/")" aria-current="@CurrentPage("/")">Home</a>
        <a href="/search" class="@ActiveIf("/search")" aria-current="@CurrentPage("/search")">Search</a>
        <AuthorizeView>
            <Authorized>
                <a href="/mybookings" class="@ActiveIf("/mybookings")" aria-current="@CurrentPage("/mybookings")">My Bookings</a>
                <a href="/profile" class="@ActiveIf("/profile")" aria-current="@CurrentPage("/profile")">Profile</a>
                @* Only staff accounts (users with the "Admin" role claim) ever see this link. *@
                <AuthorizeView Roles="Admin" Context="admin">
                    <a href="/admin" class="@ActiveIf("/admin")" aria-current="@CurrentPage("/admin")">Admin</a>
                </AuthorizeView>
                <a href="/logout" class="afg-nav-logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="afg-nav-logout">Sign in with Google</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<main id="main-content" tabindex="-1">
    @Body
</main>

<footer class="afg-footer">
    AllFlightGo © @DateTime.Now.Year
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool MenuOpen;
    private void ToggleMenu() => MenuOpen = !MenuOpen;

    private string ActiveIf(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return current.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    // Tells screen readers which link is the current page ("aria-current=page").
    // Returns null for the others so the attribute isn't rendered at all.
    private string? CurrentPage(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return current.Equals(path, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        MenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}