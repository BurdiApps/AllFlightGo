@page "/admin/login"

@* Plain HTML form posting to the /admin/authenticate endpoint. The app sets a
   global InteractiveServer render mode (App.razor), so an EditForm here would be
   interactive and couldn't complete a cookie sign-in. A real form POST to a
   minimal-API endpoint has a full HttpContext, so PasswordSignInAsync works.
   Isolated from the Google /login flow. *@

<PageTitle>Admin Sign in — AllFlightGo</PageTitle>

<div class="afg-container">
    <h1 class="afg-title">Admin Sign in</h1>
    <p>Staff access to the AllFlightGo management dashboard.</p>

    <div class="afg-card" style="max-width: 420px; margin-top: 20px;">
        <form method="post" action="/admin/authenticate">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            @if (ShowError)
            {
                <div style="background:#fee2e2; color:#991b1b; padding:10px 12px; border-radius:6px; margin-bottom:14px; font-size:14px;">
                    Invalid credentials or not an admin account.
                </div>
            }

            <div class="afg-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="username" required />
            </div>

            <div class="afg-field" style="margin-top:12px;">
                <label for="password">Password</label>
                <input id="password" name="password" type="@(ShowPassword ? "text" : "password")"
                       autocomplete="current-password" required />
                <span role="button" tabindex="0" @onclick="() => ShowPassword = !ShowPassword"
                      style="display:inline-block; margin-top:6px; font-size:13px; color:#2563eb; cursor:pointer; user-select:none;">
                    @(ShowPassword ? "Hide password" : "Show password")
                </span>
            </div>

            <button class="afg-btn" type="submit" style="width:100%; margin-top:16px;">Sign in</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorFlag { get; set; }

    private bool ShowError => !string.IsNullOrEmpty(ErrorFlag);

    private bool ShowPassword { get; set; }
}
