@using AllFlight.Services

@page "/flight-details"
@inject SelectedFlightService SelectedFlight
@inject NavigationManager Nav

@if (flight is null)
{
    <p>No flight selected. <a href="/search">Back to search</a></p>
}
else
{
    <div class="afg-container">
        <h1 class="afg-title">@flight.Origin → @flight.Destination</h1>
        <div class="afg-details-layout">
            <div>
                <div class="afg-card">
                    <h2>Flight Details</h2>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div><small>Airline</small><div>@flight.Airline</div></div>
                        <div><small>Flight Number</small><div>@flight.FlightNumber</div></div>
                        <div><small>Departure</small><div>@flight.Origin — @flight.Departure.ToString("h:mm tt")</div></div>
                        <div><small>Arrival</small><div>@flight.Destination — @flight.Arrival.ToString("h:mm tt")</div></div>
                        <div><small>Duration</small><div>@flight.Duration.ToString(@"h\h\ mm\m")</div></div>
                        <div><small>Stops</small><div>@(flight.Stops == 0 ? "Nonstop" : $"{flight.Stops} stop(s)")</div></div>
                        <div><small>Base Fare</small><div>@(Money.Usd(flight.BaseFare) ?? "Not disclosed")</div></div>
                        <div><small>Taxes & Fees</small><div>@(Money.Usd(flight.TaxesAndFees) ?? "Not disclosed")</div></div>
                        <div><small>Total Price</small><div>@Money.Usd(flight.Price)</div></div>
                    </div>
                </div>

                <div class="afg-card" style="margin-top:16px;">
                    <h2>Policies</h2>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div><small>Baggage Fees</small><div>@(flight.BaggagePolicy ?? "Not disclosed")</div></div>
                        <div><small>Seat Selection</small><div>@(flight.SeatSelectionIncluded is null ? "Not disclosed" : (flight.SeatSelectionIncluded.Value ? "Included" : "Fee applies"))</div></div>
                        <div><small>Cancellation</small><div>@(flight.CancellationPolicy ?? "Not disclosed")</div></div>
                        <div><small>Changes</small><div>@(flight.ChangeFee is null ? "Not disclosed" : Money.Usd(flight.ChangeFee.Value) + " fee")</div></div>
                    </div>
                </div>
            </div>

            <div>
                <div class="afg-card">
                    <h2>Transparency Score</h2>
                    <div class="afg-score-num"
                         style="font-size:48px; color:@TransparencyScoreCalculator.BandColor(flight.Score)"
                         role="img"
                         aria-label="Transparency score @flight.Score out of 100">
                        @flight.Score<span style="font-size:18px; color:#6b7280;"> / 100</span>
                    </div>
                    <div class="afg-score-track" style="margin:12px 0;">
                        <div class="afg-score-mask" style="left:@(flight.Score)%"></div>
                    </div>
                    <button class="afg-btn" @onclick="ViewBreakdown">View Breakdown</button>
                </div>

                <div class="afg-card" style="margin-top:16px;">
                    <div style="font-size:24px; font-weight:bold;">@Money.Usd(flight.Price)</div>
                    <small>total, taxes included</small>
                    <button class="afg-btn" style="width:100%; margin-top:12px;" @onclick="SelectSeat">Select Seat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Flight? flight;

    protected override void OnInitialized()
    {
        flight = SelectedFlight.Current;
    }

    private void SelectSeat()
    {
        Nav.NavigateTo("/select-seat");
    }

    private void ViewBreakdown()
    {
        Nav.NavigateTo("/transparency-breakdown");
    }
}