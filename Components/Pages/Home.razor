@page "/"
@using AllFlight.Components.Shared
@inject NavigationManager Nav

<PageTitle>AllFlightGo</PageTitle>

<section class="afg-hero" style="background-image: linear-gradient(rgba(15,23,42,0.55), rgba(15,23,42,0.55)), url('img/allflight-hero-img.jpg'); background-size: cover; background-position: center;">
    <div class="afg-hero-content">
        <h1>Go Anywhere</h1>
        <p>Compare flights from every airline in one place — save time, save money.</p>
    </div>
</section>

<div class="afg-container">
    <AuthorizeView>
        <Authorized>
            <div class="afg-card" style="max-width: 480px; margin-bottom: 24px;">
                <h2 style="margin-top: 0;">Welcome back</h2>
                <p>Your account is ready. Continue to your bookings to manage your trips.</p>
                <a class="afg-btn" href="/mybookings">View my bookings</a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="afg-card" style="max-width: 480px; margin-bottom: 24px;">
                <h2 style="margin-top: 0;">Sign in with Google</h2>
                <p>Use your Google account to save and manage your travel plans.</p>
                <a class="afg-btn" href="/login">Continue with Google</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <h2 class="afg-title">Find Your Flight</h2>

    <SearchFlights OnSubmit="HandleSearch" />

    <div class="afg-section-title">Popular Destinations</div>
    <div class="afg-destinations">
        @foreach (var d in Destinations)
        {
            <div class="afg-destination">
                <img class="thumb" src="@d.Image" alt="@d.Name" />
                <div class="name">@d.Name</div>
            </div>
        }
    </div>

    <div class="afg-section-title">Featured Deals</div>
    <div class="afg-deals">
        <div class="afg-deal">Deal A</div>
        <div class="afg-deal">Deal B</div>
        <div class="afg-deal">Deal C</div>
    </div>
</div>

@code {
    private (string Name, string Image)[] Destinations = new[]
    {
        ("Los Angeles", "img/dest-los-angeles.jpeg"),
        ("Abuja", "img/dest-abuja.jpeg"),
        ("Salt Lake City", "img/dest-salt-lake-city.jpeg"),
        ("Mexico City", "img/dest-mexico-city.jpeg"),
    };

    private void HandleSearch(SearchFlights.SearchCriteria c)
    {
        var url = $"/search?origin={Uri.EscapeDataString(c.Origin)}"
                + $"&destination={Uri.EscapeDataString(c.Destination)}"
                + $"&date={c.DepartureDate:yyyy-MM-dd}"
                + $"&passengers={c.Passengers}";
        Nav.NavigateTo(url);
    }
}