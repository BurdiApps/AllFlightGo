@page "/search"
@attribute [Authorize]
@using AllFlight.Services
@using AllFlight.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject FlightService Flights
@inject NavigationManager Nav
@inject SelectedFlightService SelectedFlight
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Search Results — AllFlightGo</PageTitle>

<div class="afg-search-layout">

    <!-- Filters sidebar -->
    <aside class="afg-filters">
        <div class="afg-section-title" style="margin-top:0;">Filters</div>

        <!-- Sort: lets the user reorder the list. "Best score" is our default because
             the whole point of the app is the Transparency Score. -->
        <div class="afg-field">
            <label for="filter-sort">Sort by</label>
            <select id="filter-sort" @bind="SortBy" @bind:after="ResetPage">
                <option value="best">Best score</option>
                <option value="price-asc">Price: low to high</option>
                <option value="price-desc">Price: high to low</option>
                <option value="duration">Shortest trip</option>
            </select>
        </div>

        <!-- Every filter calls ResetPage after it changes so we jump back to page 1
             (otherwise you could be stuck on "page 5" of a now-shorter list). -->
        <div class="afg-field">
            <label for="filter-price">Max Price ($@MaxPrice)</label>
            <input id="filter-price" type="range" min="100" max="2000" step="10" @bind="MaxPrice" @bind:after="ResetPage" />
        </div>

        <div class="afg-field">
            <label for="filter-stops">Stops</label>
            <select id="filter-stops" @bind="StopsFilter" @bind:after="ResetPage">
                <option value="-1">Any</option>
                <option value="0">Nonstop</option>
                <option value="1">1 Stop</option>
                <option value="2">2+ Stops</option>
            </select>
        </div>

        <div class="afg-field">
            <label for="filter-airline">Airline</label>
            <select id="filter-airline" @bind="AirlineFilter" @bind:after="ResetPage">
                <option value="">All</option>
                @foreach (var a in AllResults.Select(x => x.Airline).Distinct())
                {
                    <option value="@a">@a</option>
                }
            </select>
        </div>
    </aside>

    <!-- Results -->
    <section class="afg-results">

        <!-- "New search" bar. The user asked to be able to start a brand-new search
             right from the results page, instead of going back to the home page. -->
        <div style="margin-bottom:16px;">
            <button class="afg-btn-outline" @onclick="() => ShowSearch = !ShowSearch">
                @(ShowSearch ? "✕ Close search" : "✈ New search")
            </button>
        </div>

        @if (ShowSearch)
        {
            <div style="margin-bottom:20px;">
                @* Reuse the same search box from the home page. We prefill it with the
                   current trip so it's easy to tweak just one thing (like the date). *@
                <SearchFlights OnSubmit="HandleNewSearch"
                               InitialOrigin="@Origin"
                               InitialDestination="@Destination"
                               InitialDate="Date"
                               InitialPassengers="Passengers" />
            </div>
        }

        <h1 class="afg-title" style="margin-top:0;">
            Results: @Origin → @Destination · @Date.ToString("MMM d, yyyy")
        </h1>

        @if (IsLoading)
        {
            <p role="status">🔍 Searching flights...</p>
        }
        else if (string.IsNullOrWhiteSpace(Origin) || string.IsNullOrWhiteSpace(Destination))
        {
            <p>Start a search from the <a href="/">home page</a> to see results here.</p>
        }
        else if (!AllResults.Any())
        {
            <p>No flights found. Try different airports or a later date (Duffel test data works best 30+ days out).</p>
        }
        else if (!Filtered.Any())
        {
            <p>No flights match your filters.</p>
        }
        else
        {
            <!-- Little "Showing X of Y" line so the user knows the list is paginated. -->
            <p style="color:#64748b; font-size:14px; margin-bottom:12px;">
                Showing @Paged.Count() of @Sorted.Count() flights
            </p>

            @foreach (var f in Paged)
            {
                <div class="afg-flight-card">
                    <div class="afg-flight-logo">✈</div>

                    <div class="afg-flight-info">
                        <div class="afg-flight-num">@f.Airline · @f.FlightNumber</div>
                        <div class="afg-flight-route"><strong>@f.Origin → @f.Destination</strong></div>
                        <div class="afg-flight-times">
                            @f.Departure.ToString("h:mm tt") → @f.Arrival.ToString("h:mm tt")
                        </div>
                        <div class="afg-flight-stops">@(f.Stops == 0 ? "Nonstop" : $"{f.Stops} Stop(s)")</div>
                    </div>

                    <div class="afg-flight-score">
                        <div class="label">Score</div>
                        <div class="value">@f.Score/100</div>
                    </div>

                    <div class="afg-flight-action">
                        <div class="price">$@f.Price</div>
                        <button class="afg-btn" @onclick="() => ViewDetails(f)">View Details</button>
                    </div>
                </div>
            }

            <!-- Page buttons only show up when there's more than one page of results. -->
            @if (TotalPages > 1)
            {
                <div class="afg-pagination">
                    <button @onclick="() => GoToPage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">‹ Prev</button>
                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pageNum = p; // copy into a local so each button remembers its own number
                        <button class="@(pageNum == CurrentPage ? "active" : "")"
                                @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button @onclick="() => GoToPage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">Next ›</button>
                </div>
            }
        }
    </section>
</div>

@code {
    // The trip we're currently showing results for (read from the URL query string).
    private string Origin = "";
    private string Destination = "";
    private DateTime Date = DateTime.Today.AddDays(30);
    private int Passengers = 1;

    // Filter values controlled by the sidebar.
    private decimal MaxPrice = 2000;
    private int StopsFilter = -1;
    private string AirlineFilter = "";
    private string SortBy = "best"; // default sort = highest Transparency Score first

    private bool ShowSearch = false; // is the "New search" box open?

    // Pagination: show 8 flights per page.
    private const int PageSize = 8;
    private int CurrentPage = 1;

    private bool IsLoading = true;
    private List<Flight> AllResults = new();

    // Apply the sidebar filters (price, stops, airline).
    private IEnumerable<Flight> Filtered =>
        AllResults
            .Where(f => f.Price <= MaxPrice)
            .Where(f => StopsFilter == -1 || (StopsFilter == 2 ? f.Stops >= 2 : f.Stops == StopsFilter))
            .Where(f => string.IsNullOrEmpty(AirlineFilter) || f.Airline == AirlineFilter);

    // Then sort whatever's left based on the dropdown.
    private IEnumerable<Flight> Sorted => SortBy switch
    {
        "price-asc"  => Filtered.OrderBy(f => f.Price),
        "price-desc" => Filtered.OrderByDescending(f => f.Price),
        "duration"   => Filtered.OrderBy(f => f.Arrival - f.Departure),
        _            => Filtered.OrderByDescending(f => f.Score) // "best"
    };

    // How many pages we need, and which slice of flights to show right now.
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Sorted.Count() / (double)PageSize));
    private IEnumerable<Flight> Paged => Sorted.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    // Jump to a page (ignoring out-of-range clicks).
    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
    }

    // Any time a filter/sort changes, go back to page 1.
    private void ResetPage() => CurrentPage = 1;

    // Subscribe to URL changes so searching again (even from the home page while we're
    // already on /search) re-runs the search. Godfrey added this pattern originally.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await LoadResults();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadResults();
    }

    // Read the trip out of the URL and ask Duffel for matching flights.
    private async Task LoadResults()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);

        Origin = q.TryGetValue("origin", out var o) ? o.ToString().ToUpper() : "";
        Destination = q.TryGetValue("destination", out var d) ? d.ToString().ToUpper() : "";
        Date = q.TryGetValue("date", out var dt) && DateTime.TryParse(dt, out var parsed)
            ? parsed : DateTime.Today.AddDays(30);
        Passengers = q.TryGetValue("passengers", out var p) && int.TryParse(p, out var pi) ? pi : 1;

        CurrentPage = 1; // new results, so start at the first page

        if (string.IsNullOrWhiteSpace(Origin) || string.IsNullOrWhiteSpace(Destination))
        {
            AllResults = new();
            IsLoading = false;
            return;
        }

        IsLoading = true;
        AllResults = await Flights.SearchAsync(Origin, Destination, Date, Passengers);
        IsLoading = false;
    }

    // When the user searches from the in-page box, just change the URL. The
    // LocationChanged handler above notices and re-runs the search for us.
    private void HandleNewSearch(SearchFlights.SearchCriteria c)
    {
        ShowSearch = false;
        var url = $"/search?origin={c.Origin}&destination={c.Destination}&date={c.DepartureDate:yyyy-MM-dd}&passengers={c.Passengers}";
        Nav.NavigateTo(url);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void ViewDetails(Flight f)
    {
        SelectedFlight.Set(f);
        Nav.NavigateTo("/flight-details");
    }
}
