@page "/search"
@attribute [Authorize]
@using AllFlight.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject FlightService Flights
@inject NavigationManager Nav
@inject SelectedFlightService SelectedFlight
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Search Results — AllFlightGo</PageTitle>

<div class="afg-search-layout">

    <!-- Filters -->
    <aside class="afg-filters">
        <div class="afg-section-title" style="margin-top:0;">Filters</div>

        <div class="afg-field">
            <label>Max Price ($@MaxPrice)</label>
            <input type="range" min="100" max="2000" step="10" @bind="MaxPrice" @bind:event="oninput" @bind:after="ResetPage" />
        </div>

        <div class="afg-field">
            <label>Stops</label>
            <select @bind="StopsFilter" @bind:after="ResetPage">
                <option value="-1">Any</option>
                <option value="0">Nonstop</option>
                <option value="1">1 Stop</option>
                <option value="2">2+ Stops</option>
            </select>
        </div>

        <div class="afg-field">
            <label>Airline</label>
            <select @bind="AirlineFilter" @bind:after="ResetPage">
                <option value="">All</option>
                @foreach (var a in AllResults.Select(x => x.Airline).Distinct())
                {
                    <option value="@a">@a</option>
                }
            </select>
        </div>
    </aside>

    <!-- Results -->
    <section class="afg-results">
        <h2 class="afg-title" style="margin-top:0;">
            Results: @Origin → @Destination · @Date.ToString("MMM d, yyyy")
        </h2>

        @if (IsLoading)
        {
            <p>🔍 Searching flights...</p>
        }
        else if (string.IsNullOrWhiteSpace(Origin) || string.IsNullOrWhiteSpace(Destination))
        {
            <p>Start a search from the <a href="/">home page</a> to see results here.</p>
        }
        else if (!AllResults.Any())
        {
            <p>No flights found. Try different airports or a later date (Duffel test data works best 30+ days out).</p>
        }
        else if (!Filtered.Any())
        {
            <p>No flights match your filters.</p>
        }
        else
        {
            @foreach (var f in PagedResults)
            {
                <div class="afg-flight-card">
                    <div class="afg-flight-logo">✈</div>

                    <div class="afg-flight-info">
                        <div class="afg-flight-num">@f.Airline · @f.FlightNumber</div>
                        <div class="afg-flight-route"><strong>@f.Origin → @f.Destination</strong></div>
                        <div class="afg-flight-times">
                            @f.Departure.ToString("h:mm tt") → @f.Arrival.ToString("h:mm tt")
                        </div>
                        <div class="afg-flight-stops">@(f.Stops == 0 ? "Nonstop" : $"{f.Stops} Stop(s)")</div>
                    </div>

                    <div class="afg-flight-score">
                        <div class="label">Score</div>
                        <div class="value">@f.Score/100</div>
                    </div>

                    <div class="afg-flight-action">
                        <div class="price">$@f.Price</div>
                        <button class="afg-btn" @onclick="() => ViewDetails(f)">View Details</button>
                    </div>
                </div>
            }

            @if (TotalPages > 1)
            {
                <div class="afg-pagination">
                    <button class="afg-btn" disabled="@(CurrentPage == 1)" @onclick="() => GoToPage(CurrentPage - 1)">← Previous</button>
                    <span>Page @CurrentPage of @TotalPages</span>
                    <button class="afg-btn" disabled="@(CurrentPage == TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)">Next →</button>
                </div>
            }
        }
    </section>
</div>

@code {
    private string Origin = "";
    private string Destination = "";
    private DateTime Date = DateTime.Today.AddDays(30);
    private int Passengers = 1;

    private decimal MaxPrice = 2000;
    private int StopsFilter = -1;
    private string AirlineFilter = "";

    private bool IsLoading = true;
    private List<Flight> AllResults = new();

    private int CurrentPage = 1;
    private const int PageSize = 10;

    private IEnumerable<Flight> Filtered =>
        AllResults
            .Where(f => f.Price <= MaxPrice)
            .Where(f => StopsFilter == -1 || (StopsFilter == 2 ? f.Stops >= 2 : f.Stops == StopsFilter))
            .Where(f => string.IsNullOrEmpty(AirlineFilter) || f.Airline == AirlineFilter);

    private int TotalPages => (int)Math.Ceiling(Filtered.Count() / (double)PageSize);

    private IEnumerable<Flight> PagedResults =>
        Filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
    }

    private void ResetPage() => CurrentPage = 1;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await LoadResults();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadResults();
    }

    private async Task LoadResults()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);

        Origin = q.TryGetValue("origin", out var o) ? o.ToString().ToUpper() : "";
        Destination = q.TryGetValue("destination", out var d) ? d.ToString().ToUpper() : "";
        Date = q.TryGetValue("date", out var dt) && DateTime.TryParse(dt, out var parsed)
            ? parsed : DateTime.Today.AddDays(30);
        Passengers = q.TryGetValue("passengers", out var p) && int.TryParse(p, out var pi) ? pi : 1;

        CurrentPage = 1;

        if (string.IsNullOrWhiteSpace(Origin) || string.IsNullOrWhiteSpace(Destination))
        {
            AllResults = new();
            IsLoading = false;
            return;
        }

        IsLoading = true;
        AllResults = await Flights.SearchAsync(Origin, Destination, Date, Passengers);
        IsLoading = false;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void ViewDetails(Flight f)
    {
        SelectedFlight.Set(f);
        Nav.NavigateTo("/flight-details");
    }
}